{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/logo/Nazuna_Nanakusa_student.png",
    "padding": {
      "top": 1,
      "bottom": 1,
      "left": 1,
      "right": 1
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "font",
    "terminal",
    "terminalfont",
    "memory",
    "battery",
    "poweradapter"
  ]
}
