configuration {
  modes:               "drun,run,window";
  font:                "JetBrainsMono Nerd Font 11";
  show-icons:          true;
  drun-display-format: "{name}";
  display-drun:        "Apps";
  display-run:         "Run";
  display-window:      "Windows";
  window-format:       "{w}  {c}";
}

@theme "catppuccin-mocha"
