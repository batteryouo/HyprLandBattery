@import "catppuccin-mocha"

window {
  location:         northwest;
  anchor:           northwest;
  x-offset:         8px;
  y-offset:         36px;
  width:            26em;
  background-color: rgba(30, 30, 46, 96%);
  border:           1px;
  border-color:     @accent;
  border-radius:    12px;
}

mainbox {
  padding:  14px;
  children: [ textbox-launcher-title, inputbar, message, listview ];
}

textbox-launcher-title {
  content:          "Program Launcher";
  font:             "JetBrainsMono Nerd Font 14";
  text-color:       @accent;
  background-color: transparent;
  padding:          0 2px;
  margin:           0 0 10px 0;
}

inputbar {
  background-color: @bg-alt;
  margin:           0 0 12px 0;
}

listview {
  lines:   8;
  spacing: 6px;
}

element {
  background-color: @bg-alt;
  padding:          9px 12px;
  border-radius:    9px;
}

element selected {
  background-color: @bg-selected;
}

element-icon {
  size: 1.4em;
}
