{
  "layer": "top",
  "position": "top",
  "height": 16,
  "margin-top": 4,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 0,
  "modules-left": ["custom/launcher", "hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "battery", "group/tray", "custom/quicksettings"],

  "custom/launcher": {
    "format": "󰣇",
    "tooltip-format": "App Launcher",
    "on-click": "~/.config/hypr/scripts/app-launcher.sh"
  },

  "hyprland/workspaces": {
    "format": "●",
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "sort-by-number": true
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a, %d %b %Y}",
    "format-alt-click": 3,
    "tooltip": false,
    "on-click": "python3 ~/.config/eww/scripts/panels.py toggle calendar-panel"
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰖁  Muted",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "{desc} · {volume}%"
  },

  "network": {
    "format-wifi": "󰖩  {signalStrength}%",
    "format-ethernet": "󰈀  Wired",
    "format-disconnected": "󰖪  Offline",
    "tooltip-format-wifi": "{essid}\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "on-click": "python3 ~/.config/eww/scripts/panels.py toggle wifi-panel",
    "on-click-right": "nm-connection-editor"
  },

  "battery": {
    "interval": 30,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "󰚥  {capacity}%",
    "format-alt": "{timeToEmpty}",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "on-click": "mode"
  },

  "group/tray": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 180,
      "children-class": "tray-drawer",
      "transition-left-to-right": false,
      "click-to-reveal": true
    },
    "modules": ["custom/tray-toggle", "tray"]
  },

  "custom/tray-toggle": {
    "format": "󰇙",
    "tooltip-format": "System tray"
  },

  "tray": {
    "icon-size": 14,
    "spacing": 8
  },

  "custom/quicksettings": {
    "format": "󰅀",
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "~/.config/eww/scripts/toggle-quicksettings.sh",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  }
}
